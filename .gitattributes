# Normalise text; never touch binaries
* text=auto
*.bat text eol=crlf

*.glb binary
*.gltf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.blend binary
*.mp4 binary
*.mov binary

# Large source files go through Git LFS (up to 2 GB each). Only this folder,
# so ordinary browser uploads elsewhere in mridul/ stay simple.
mridul/source-files/** filter=lfs diff=lfs merge=lfs -text
mridul/source-files/.gitkeep !filter !diff !merge text
